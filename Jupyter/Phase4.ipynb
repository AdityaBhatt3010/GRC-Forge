      "Processing: GDPR\n",
      "Done: GDPR\n",
      "Processing: HIPAA\n",
      "Done: HIPAA\n",
      "Processing: ISO27001\n",
      "Done: ISO27001\n",
      "Processing: NIST800_53V5\n",
